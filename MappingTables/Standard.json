{
  "comment": "Standard IFC mapping table: TPF/usBridge locations, which is what PGSuper exports. Agency tables extend it with \"extends\": \"standard\". See devdocs/MappingTablesDesign.md. The property sets reproduce the exporter's property sets as of 2026-09-29, with the export findings of the design note fixed. The types of properties without a value are placeholders until they are checked against bSDD. The reinforcing bar property sets whose values come from the rebar detailing (usBrPset_ACI_ReinforcingBarType, usBrPset_ACI_ReinforcingBar, usBrPset_ACI_ReinforcingCover, usBrPset_ACI_BarShape) and the bar count quantity stay in code (design note, M3 stage 3).",
  "format": "PGSuperIfcMapping",
  "version": 1,
  "name": "Standard (TPF/usBridge)",
  "elements": {
    "project": {"entity": "IfcProject"},
    "site": {"entity": "IfcSite"},
    "bridge": {"entity": "IfcBridge", "predefined_type": "GIRDER"},
    "superstructure": {"entity": "IfcBridgePart", "predefined_type": "SUPERSTRUCTURE"},
    "substructure": {"entity": "IfcBridgePart", "predefined_type": "SUBSTRUCTURE"},
    "deck_part": {"entity": "IfcBridgePart", "predefined_type": "DECK"},
    "pier": {"entity": "IfcBridgePart", "predefined_type": "PIER"},
    "abutment": {"entity": "IfcBridgePart", "predefined_type": "ABUTMENT"},
    "foundation": {"entity": "IfcBridgePart", "predefined_type": "FOUNDATION"},
    "girder": {"entity": "IfcBeam", "predefined_type": "BEAM"},
    "girder_assembly": {"entity": "IfcElementAssembly", "predefined_type": "GIRDER"},
    "closure_joint": {"entity": "IfcBeam", "attributes": {"ObjectType": "CLOSUREJOINT"}},
    "tendon": {"entity": "IfcTendon", "predefined_type": "STRAND"},
    "tendon_bundle": {"entity": "IfcElementAssembly", "predefined_type": "USERDEFINED"},
    "rebar": {"entity": "IfcReinforcingBar"},
    "reinforcement_cage": {"entity": "IfcElementAssembly", "predefined_type": "REINFORCEMENT_UNIT"},
    "deck": {"entity": "IfcSlab", "predefined_type": "FLOOR"},
    "barrier": {"entity": "IfcWall", "predefined_type": "USERDEFINED", "attributes": {"ObjectType": "BARRIER"}},
    "bearing": {"entity": "IfcBearing"}
  },
  "property_sets": [
    {
