        {"name": "ProjectType", "type": "IfcLabel", "value": "NEWBUILD", "enumeration": {"name": "PEnum_ProjectType", "values": ["MODIFICATION", "NEWBUILD", "OPERATIONMAINTENANCE", "RENOVATION", "REPAIR"]}}
      ]
    },
    {
      "name": "usBrPset_ProjectCommon", "applies_to": "project",
      "properties": [
