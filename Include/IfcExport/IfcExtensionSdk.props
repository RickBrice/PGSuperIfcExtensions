<?xml version="1.0" encoding="utf-8"?>
<!--
   The build settings the IFC extension and its export extensions must share (see IfcModelBuilder.h).
   An export extension shares C++ objects with the IFC extension (the IfcOpenShell file and its entities), so both
   must use the same IfcOpenShell build and the same IfcOpenShell defines. Import this sheet in both projects.
   The defines are the ones IfcOpenShell's own build uses (IfcParse exports IFOPSH_WITH_ROCKSDB, and IFOPSH_SAFE_INSTANCE
   changes every entity class). IfcOpenShell is built with BOOST_ALL_NO_LIB: its DLLs bring the Boost code they need.
   The IFC extension checks the build fingerprint (IfcExport::BuildFingerprint) before it uses an extension.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <IfcExtensionSdkDir>$(MSBuildThisFileDirectory)</IfcExtensionSdkDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..;$(IFCOPENSHELL_DIR)\src;$(BOOSTDIR);$(IFCOPENSHELL_DIR)\_deps-vs2026-$(Platform)-installed\rocksdb\include;$(IFCOPENSHELL_DIR)\_deps-vs2026-$(Platform)-installed\Eigen;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>HAS_SCHEMA_4x3_add2;IFOPSH_SAFE_INSTANCE;IFOPSH_WITH_ROCKSDB;BOOST_ALL_NO_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <DisableSpecificWarnings>4250;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <Link>
      <AdditionalDependencies>$(IFCOPENSHELL_DIR)\_build-vs2026-$(Platform)\ifcparse\Debug\ifcopenshell_parse_d.lib;$(IFCOPENSHELL_DIR)\_build-vs2026-$(Platform)\ifcparse\Debug\ifcopenshell_parse_schema_ifc4x3_add2_d.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <Link>
      <AdditionalDependencies>$(IFCOPENSHELL_DIR)\_installed-vs2026-$(Platform)\lib\ifcopenshell_parse.lib;$(IFCOPENSHELL_DIR)\_installed-vs2026-$(Platform)\lib\ifcopenshell_parse_schema_ifc4x3_add2.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
